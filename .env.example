# Copy this file to .env and adjust if needed. No API keys are required:
# every source used by the platform is a free, keyless public feed or service.

# How many days of feed history to keep in an investigation (max 30 for URLhaus "recent").
WINDOW_DAYS=30

# Set to 1 to rebuild everything from the committed snapshot in data/snapshot/
# without making any network requests.
OFFLINE=0

# Flask dashboard
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
